// === Grammar TARRI Stabil — Versi Terbaru ===



start: top_level_stmt*

// --------------------
// Top-level statements
// --------------------
?top_level_stmt: var_decl
               | func_decl
               | class_decl
               | entry_point
               | import_stmt
               | expr_stmt

// --------------------
// Struktur program
// --------------------
entry_point: ("titikawal"|"awal"|"@")  block

block: "{" statement* "}"

?statement: var_decl
          | func_decl
          | class_decl
          | if_stmt
          | loop_stmt
          | try_catch_stmt
          | return_stmt
          | break_stmt
          | continue_stmt
        //   | print_stmt
          | expr_stmt
          | entry_point
          | tabel_stmt

// --------------------
// TABEL & METHOD
// --------------------
tabel_stmt: VAR_NAME ("untuk"|"utk") method_call
method_call: NAME "(" [args] ")"

// --------------------
// IMPORT & MODUL
// --------------------
import_stmt: "undang" NAME ("dari" NAME)?

// --------------------
// VARIABEL & KONST
// --------------------
var_decl: VAR_NAME (EQUAL | PLUS_EQUAL | MINUS_EQUAL) expr -> auto_var_decl

// --------------------
// FUNGSI
// --------------------
func_decl: ("fungsi"|"fn") NAME "(" [params] ")" block
params: param ("," param)*
param: VAR_NAME | NAME

return_stmt: ("tampilkan"|"tamp") expr
           | ("kembalikan"|"kemb") expr
           | ("sembunyikan"|"semb")

// --------------------
// KELAS & OOP
// --------------------
class_decl: "kelas" NAME ["perluas" NAME] block

// --------------------
// KONTROL ALUR
// --------------------
if_stmt: if_branch (("ataujika"|"atjk") expr block | ("ataujika"|"atjk") "(" expr ")" block)* [("lainnya"|"lny") block]
if_branch: (("jika"|"jk") expr block | ("jika"|"jk") "(" expr ")" block)

// --------------------
// PERULANGAN
// --------------------
loop_stmt: ("ulangi"|"ulang") block
         | ("ulangidari"|"ulangd") VAR_NAME EQUAL expr ("hingga"|"hga") expr block
         | ("selama"|"slm") expr block
         | ("setiap"|"stp") VAR_NAME ("dari"|"dr") expr block
         | ("setiapdari"|"stpd") VAR_NAME EQUAL expr ("hingga"|"hga") expr ("dari"|"dr") expr block
         | ("untuk"|"utk") VAR_NAME ("dalam"|"dlm") expr block
         | ("untuk"|"utk") "(" VAR_NAME ("dalam"|"dlm") expr ")" block (("kosong"|"ksg") block)?
         | ("untuk"|"utk") ("setiap"|"stp") VAR_NAME ("dalam"|"dlm") expr block



break_stmt: ("hentikan"|"henti")
continue_stmt: ("lanjutkan"|"lanjut")

// --------------------
// ERROR HANDLING
// --------------------
try_catch_stmt: ("coba"|"cb") block ("tangkap"|"tgkp") "(" VAR_NAME ")" block [("akhirnya"|"akhir") block]

// --------------------
// PRINT & OUTPUT
// --------------------
// print_stmt: ("cetak"|"ctk") "(" [expr ("," expr)*] ")"

// --------------------
// EKSPRESI (precedence-aware)
// --------------------
// top-level expr
expr_stmt: expr

?expr: expr_or

// OR level (||  or "atau")
?expr_or: expr_or OR_OP expr_and            -> or_expr
        | expr_or ("atau"|"atw") expr_and   -> or_expr
        | expr_and

// AND level (&& or "dan")
?expr_and: expr_and AND_OP expr_not   -> and_expr
         | expr_and ("dan") expr_not  -> and_expr
         | expr_not

// IN / 'dalam' (keperluan membership dan juga dipakai pada loop — grammar tetap eksplisit)
?expr_in: expr_in ("dalam"|"dlm") expr_not  -> in_expr
        | expr_not

// NOT / unary (supports ! dan 'bukan')
?expr_not: NOT expr_not              -> not_expr
         | ("bukan"|"bkn") expr_not  -> not_expr
         | expr_cmp

// Comparison
?expr_cmp: expr_cmp COMP_OP expr_add -> compare_expr
         | expr_add

// Add / Sub
?expr_add: expr_add ADD_OP expr_mul  -> add_expr
         | expr_mul

// Mul / Div / Mod
?expr_mul: expr_mul MUL_OP expr_atom -> mul_expr
         | expr_atom

// --------------------
// SUBCALL khusus modul: `sqlite koneksi(...)`
// bentuk: <moduleName> <actionName> ( args )
// letakkan terpisah agar tidak mengacaukan call_expr
// --------------------
subcall_expr: (VAR_NAME | NAME) NAME "(" [args] ")"

// --------------------
// ATOM / EKSPRESI DASAR
// Penempatan: subcall_expr diutamakan
// Hindari left recursion yang ambiguous
// --------------------
?expr_atom: subcall_expr
          | atom
          | "(" expr ")"                 -> grouped_expr
          | expr_atom "(" [args] ")"     -> call_expr
          | expr_atom "." VAR_NAME       -> attr_access
          | expr_atom "[" index_expr "]" -> indexing
          | expr_atom "->" TYPE_CAST     -> type_cast

// --------------------
// ARGUMEN / INDEX
// --------------------
args: expr ("," expr)*

?index_expr: expr                       -> single_index
           | expr ("..") expr           -> slice_expr
           | expr ("&") expr+           -> pair_expr
           |                            -> empty_index

// --------------------
// LITERAL / NILAI
// --------------------
?atom: NUMBER                 -> number
     | ESCAPED_STRING         -> string
     | TRIPLE_STRING          -> string
     | SINGLE_QUOTE_STRING    -> string
     | "Benar"                -> true
     | "Salah"                -> false
     | "Kosong"               -> null
     | "Hampa"                -> null
     | VAR_NAME
     | NAME
     | list_literal
     | dict_literal

list_literal: "[" [expr ("," expr)*] "]"
dict_literal: "{" [dict_pair ("," dict_pair)*] "}"
// dukung kedua bentuk ":" dan "=" pada dict pair
dict_pair: (VAR_NAME | ESCAPED_STRING | NAME) (":" | "=") expr

// --------------------
// OPERATOR & TOKEN (terminal)
// --------------------
COMP_OP: "==" | "!=" | "<" | ">" | "<=" | ">="
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
PLUS_EQUAL: "+="
MINUS_EQUAL: "-="

// boolean / logical tokens (terminal)
NOT: "!"
AND_OP: "&&"
OR_OP: "||"

// single equals (assignment operator token already EQUAL above)
EQUAL: "="

// variable / name tokens
VAR_NAME: /_[a-zA-Z][a-zA-Z0-9_]*/
NAME: /[a-zA-Z][a-zA-Z0-9_]*/

// numbers
FLOAT: /-?\d+\.\d+/
INT:   /-?\d+/
NUMBER: FLOAT | INT

ESCAPED_STRING: /"[^"]*"/
TRIPLE_STRING: /(\"\"\"([^\"\\]|\\.|\"(?!\"\")|\\n)*\"\"\")|('''([^'\\]|\\.|'(?!'')|\\n)*''')/
SINGLE_QUOTE_STRING: /'[^']*'/

// multiple-word tokens used earlier (kept for compatibility; but MODNAME not required here)
TYPE_CAST: "angka" | "kata"

// --------------------
// IGNORE
// --------------------
%ignore /\s+/
%ignore /#.*/
