{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TARRI",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tarri",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tarri",
          "match": "\\b(jika|jk|ataujika|ajk|lainnya|lny|ulangi|ulang|ulangidari|ulangd|hingga|hga|untuk|utk|dalam|dlm|setiap|stp|dari|dr|setiapdari|stpd|selama|slm|awal|titikawal|hentikan|henti|lanjutkan|lnjt|fungsi|fn|kembalikan|kemb|tampilkan|tamp|sembunyikan|semb|coba|cb|tangkap|tgkp|akhirnya|akhir|kelas|perluas)\\b"
        },
        {
          "name": "constant.language.tarri",
          "match": "\\b(Benar|benar|Salah|salah|Kosong|null)\\b"
        },
        {
          "name": "keyword.operator.logical.tarri",
          "match": "\\b(dan|atau|DAN|ATAU|bukan|bkn)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tarri",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tarri",
          "match": "\\\\."
        },
        {
          "name": "variable.interpolation.tarri",
          "match": "\\{[^{}]+\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.tarri",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.tarri",
          "match": "\\_[a-zA-Z0-9_]+"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.tarri",
          "match": "\\b(cetak|ctk|cetak_web|ctkw|cetak_html|ctkh|masukkan|kembalikan|tampilkan|huruf_acak|huruf_acak_rapi|lorem_ipsum|angka_acak|UUID|slug|tipe_data|urutkan_data|cari_data|termasuk|panjang|awal_kapital|ubah_kata|kunci|nilai|besar|kecil|ganti|gabung|acak|akar|pangkat|bulatkan|maksimal|minimal|rata_rata|faktorial|mod|sin|cos|tan|derajat|radian|halaman|alihkan|tujuan|rute|json|lacak|lempar_pesan|kata_bijak|buat_sandi|cek_sandi|sqlite|tabel_sqlite|mysql|tabel_mysql|sesi|waktu_proses|jam|tanggal|kalender|ambil_data_api|simpan_data_api|parse_json_api|cek_data_api|cari_data_api|perbarui_data_api|hapus_data_api|kirim_data_api)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.tarri",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tarri",
          "match": "(==|!=|<=|>=|<|>|\\+|-|\\*|/|%|\\+=|-=|\\?\\?|&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.assignment.tarri",
          "match": "="
        }
      ]
    }
  },
  "scopeName": "source.tarri"
}
