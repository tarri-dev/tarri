# complex_class.tarri — Kelas kompleks (pewarisan, diri, metode)
# Kunci: kelas, perluas, fungsi, diri, cetak, titikawal, jika

kelas Hewan {
  fungsi sapa() {
    cetak("Halo, saya hewan.")
  }
  fungsi bernafas() {
    cetak("Bernapas...")
  }
}

kelas Anjing perluas Hewan {
  fungsi sapa() {
    cetak("Guk guk! Saya anjing.")
  }
  fungsi menggonggong() {
    cetak("Guk guk guk!")
  }
}

kelas Kucing perluas Hewan {
  fungsi sapa() {
    cetak("Meong! Saya kucing.")
  }
  fungsi mengeong() {
    cetak("Meong...")
  }
}

kelas Burung perluas Hewan {
  fungsi sapa() {
    cetak("Cekrek! Saya burung.")
  }
  fungsi terbang() {
    cetak("Terbang ke langit!")
  }
}

titikawal{
  cetak("=== Kelas Kompleks ===")

  _anjing = Anjing()
  _anjing.sapa()
  _anjing.menggonggong()

  _kucing = Kucing()
  _kucing.sapa()
  _kucing.mengeong()

  _burung = Burung()
  _burung.sapa()
  _burung.terbang()

  cetak("=== Selesai ===")
}
