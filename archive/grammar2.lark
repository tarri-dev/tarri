// === Grammar TARRI Stabil — Versi Terbaru (Perbaikan) ===

start: top_level_stmt*

// --------------------
// Top-level statements
// --------------------
?top_level_stmt: var_decl
               | func_decl
               | class_decl
               | entry_point
               | import_stmt
               | expr_stmt

// --------------------
// Struktur program
// --------------------
entry_point: ("titikawal"|"awal"|"@") block

block: "{" statement* "}"

?statement: var_decl
          | func_decl
          | class_decl
          | if_stmt
          | loop_stmt
          | try_catch_stmt
          | return_stmt
          | break_stmt
          | continue_stmt
          | expr_stmt
          | entry_point
          | tabel_stmt

// --------------------
// TABEL & METHOD
// --------------------
tabel_stmt: VAR_NAME ("untuk"|"utk") method_call
method_call: NAME "(" [args] ")"

// --------------------
// IMPORT & MODUL
// --------------------
import_stmt: "undang" NAME ("dari" NAME)?

// --------------------
// VARIABEL & KONST
// --------------------
var_decl: VAR_NAME (EQUAL | PLUS_EQUAL | MINUS_EQUAL) expr -> auto_var_decl

// --------------------
// FUNGSI
// --------------------
func_decl: ("fungsi"|"fn") NAME "(" [params] ")" block
params: param ("," param)*
param: VAR_NAME | NAME

return_stmt: ("tampilkan"|"tamp") expr
           | ("kembalikan"|"kemb") expr
           | ("sembunyikan"|"semb")

// --------------------
// KELAS & OOP
// --------------------
class_decl: "kelas" NAME ["perluas" NAME] block

// --------------------
// KONTROL ALUR
// --------------------
if_stmt: if_branch (("ataujika"|"ajk") expr block | ("ataujika"|"ajk") "(" expr ")" block)* [("lainnya"|"lny") block]
if_branch: (("jika"|"jk") expr block | ("jika"|"jk") "(" expr ")" block)

// --------------------
// PERULANGAN
// --------------------
loop_stmt: ("ulangi"|"ulang") block
         | ("ulangidari"|"ulangd") VAR_NAME EQUAL expr ("hingga"|"hga") expr block
         | ("selama"|"slm") expr block
         | ("setiap"|"stp") VAR_NAME ("dari"|"dr") expr block
         | ("setiapdari"|"stpd") VAR_NAME EQUAL expr ("hingga"|"hga") expr ("dari"|"dr") expr block
         | ("untuk"|"utk") VAR_NAME ("dalam"|"dlm") expr block
         | ("untuk"|"utk") "(" VAR_NAME ("dalam"|"dlm") expr ")" block (("kosong"|"ksg") block)?
         | ("untuk"|"utk") ("setiap"|"stp") VAR_NAME ("dalam"|"dlm") expr block

break_stmt: ("hentikan"|"henti")
continue_stmt: ("lanjutkan"|"lanjut")

// --------------------
// ERROR HANDLING
// --------------------
try_catch_stmt: ("coba"|"cb") block ("tangkap"|"tgkp") "(" VAR_NAME ")" block [("akhirnya"|"akhir") block]

// --------------------
// EKSPRESI (precedence-aware)
// --------------------
expr_stmt: expr

?expr: expr_or

?expr_or: expr_or OR_OP expr_and            -> or_expr
        | expr_or ("ATAU") expr_and   -> or_expr
        | expr_and

?expr_and: expr_and AND_OP expr_not -> and_expr
         | expr_and ("DAN") expr_not -> and_expr
         | expr_not

?expr_not: NOT expr_not -> not_expr
         | ("bukan"|"bkn") expr_not -> not_expr
         | expr_cmp

?expr_cmp: expr_cmp COMP_OP expr_add -> compare_expr
         | expr_add

?expr_add: expr_add ADD_OP expr_mul -> add_expr
         | expr_mul

?expr_mul: expr_mul MUL_OP expr_atom -> mul_expr
         | expr_atom
         

// --------------------
// ATOM / EKSPRESI DASAR
// --------------------
// Prioritas parsing literal, variabel, dan grouped_expr dulu, baru function call
// ?expr_atom: grouped_expr
//           | subcall_expr
//           | atom
//           | attr_access
//           | indexing
//           | type_cast
//           | call_expr

?expr_atom: atom
          | "(" expr ")" -> grouped_expr
          | expr_atom "(" [args] ")" -> call_expr
          | expr_atom "." VAR_NAME -> attr_access
          | expr_atom "[" index_expr "]" -> indexing
          | expr_atom "->" TYPE_CAST -> type_cast
          | subcall_expr

// Hanya untuk subcall khusus modul: sqlite koneksi(...), dll
modul_call: NAME NAME "(" [args] ")"

subcall_expr: (VAR_NAME | NAME) NAME "(" [args] ")"

// --------------------
// ARGUMEN / INDEX
// --------------------
args: expr ("," expr)*

?index_expr: expr                       -> single_index
           | expr ("..") expr           -> slice_expr
           | expr ("&") expr+           -> pair_expr
           |                            -> empty_index

// --------------------
// LITERAL / NILAI
// --------------------
?atom: NUMBER                 -> number
     | ESCAPED_STRING         -> string
     | TRIPLE_STRING          -> string
     | SINGLE_QUOTE_STRING    -> string
     | "Benar"                -> true
     | "Salah"                -> false
     | "Kosong"               -> null
     | "Hampa"                -> null
     | VAR_NAME
     | NAME
     | list_literal
     | dict_literal

list_literal: "[" [expr ("," expr)*] "]"
dict_literal: "{" [dict_pair ("," dict_pair)*] "}"
dict_pair: (VAR_NAME | ESCAPED_STRING | NAME) (":" | "=") expr

// --------------------
// OPERATOR & TOKEN
COMP_OP: "==" | "!=" | "<" | ">" | "<=" | ">="
ADD_OP: "+" | "-"
MUL_OP: "*" | "/" | "%"
PLUS_EQUAL: "+="
MINUS_EQUAL: "-="
NOT: "!"
AND_OP: "&&"
OR_OP: "||"
EQUAL: "="
VAR_NAME: /_[a-zA-Z][a-zA-Z0-9_]*/
NAME: /[a-zA-Z][a-zA-Z0-9_]*/
FLOAT: /-?\d+\.\d+/
INT: /-?\d+/
NUMBER: FLOAT | INT
ESCAPED_STRING: /"[^"]*"/
TRIPLE_STRING: /(\"\"\"([^\"\\]|\\.|\"(?!\"\")|\\n)*\"\"\")|('''([^'\\]|\\.|'(?!'')|\\n)*''')/
SINGLE_QUOTE_STRING: /'[^']*'/
TYPE_CAST: "angka" | "kata"

// --------------------
// IGNORE
%ignore /\s+/
%ignore /#.*/
